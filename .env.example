# .NET 6 Training Application Environment Variables Example
# Copy this file to .env and modify the values as needed

# Application Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80

# API Service Configuration
API_PORT=8080
API_CONTAINER_NAME=training-api

# Connection String (will be constructed using above variables)
DB_CONNECTION_STRING=;

# Network Configuration
NETWORK_NAME=training-network

# File Upload Directory
FILES_DIRECTORY=./Training/Files